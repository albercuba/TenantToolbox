# Required application secrets. Generate unique values before deployment.
JWT_SECRET=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key

# One multi-tenant Microsoft Entra app registration for all client tenants.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
ENTRA_PROSPECT_REDIRECT_URI=http://localhost:8000/api/prospect/callback
FRONTEND_URL=http://localhost:5173

# Optional alert/report delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
PSA_VENDOR=generic
PSA_WEBHOOK_URL=

# Keep automatic remediation disabled unless your operational policy explicitly enables it.
AUTO_REMEDIATION_ENABLED=false
